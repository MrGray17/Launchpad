{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Launchpad",
  "version": "0.1.0",
  "identifier": "dev.mrgray17.launchpad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Launchpad",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
